# Set the default behavior to handle line endings automatically
* text=auto

# Force Unix-style (LF) line endings for codebase files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.svg text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

