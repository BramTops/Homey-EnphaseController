{
  "name": {
    "en": "Envoy Gateway (Legacy)",
    "nl": "Envoy-gateway (Verouderd)"
  },
  "deprecated": true,
  "images": {
    "small": "/drivers/envoy/assets/images/small.png",
    "large": "/drivers/envoy/assets/images/large.png"
  },
  "class": "solarpanel",
  "discovery": "enphase-envoy",
  "capabilities": [
    "onoff",
    "measure_power",
    "last_update",
    "meter_power",
    "meter_power_today",
    "power_production",
    "connected_inverters",
    "control_state",
    "metered_gateway"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Power production",
        "nl": "Stroomproductie"
      }
    }
  },
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Enphase account",
        "nl": "Enphase-account"
      },
      "children": [
        {
          "id": "user_email",
          "type": "text",
          "label": {
            "en": "Email address",
            "nl": "E-mailadres"
          },
          "placeholder": "owner-or-installer@email.com",
          "required": true,
          "value": ""
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord"
          },
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Envoy gateway",
        "nl": "Envoy-gateway"
      },
      "children": [
        {
          "id": "envoy_serial",
          "type": "text",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer"
          },
          "placeholder": "122226012345",
          "required": true,
          "value": ""
        },
        {
          "id": "envoy_ip",
          "type": "text",
          "label": {
            "en": "Local IP address",
            "nl": "Lokaal IP-adres"
          },
          "placeholder": "10.0.0.123",
          "required": true,
          "value": ""
        }
      ]
    }
  ]
}
