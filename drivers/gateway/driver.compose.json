{
  "name": {
    "en": "Enphase Gateway",
    "nl": "Enphase Gateway"
  },
  "images": {
    "small": "/drivers/gateway/assets/images/small.png",
    "large": "/drivers/gateway/assets/images/large.png"
  },
  "class": "solarpanel",
  "discovery": "enphase-envoy",
  "capabilities": [
    "onoff",
    "measure_power",
    "last_update",
    "meter_power",
    "meter_power_today",
    "power_production",
    "connected_inverters",
    "control_state",
    "metered_gateway"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Power production",
        "nl": "Stroomproductie"
      }
    }
  },
  "repair": [
    {
      "id": "repair"
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "user_email",
      "type": "text",
      "label": {
        "en": "Enphase Account Email",
        "nl": "Enphase-account e-mailadres"
      },
      "placeholder": "owner-or-installer@email.com",
      "required": true,
      "value": ""
    },
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Enphase Password",
        "nl": "Enphase-wachtwoord"
      },
      "required": true,
      "value": ""
    },
    {
      "id": "envoy_serial",
      "type": "text",
      "label": {
        "en": "Envoy Serial Number",
        "nl": "Envoy serienummer"
      },
      "placeholder": "122226012345",
      "required": true,
      "value": ""
    },
    {
      "id": "envoy_ip",
      "type": "text",
      "label": {
        "en": "Envoy Local IP Address",
        "nl": "Lokaal IP-adres van de Envoy"
      },
      "placeholder": "10.0.0.123",
      "required": true,
      "value": ""
    }
  ]
}
