        "nl": "Enphase-account",
        "fr": "Compte Enphase",
        "de": "Enphase-Konto"
      },
      "children": [
        {
          "id": "user_email",
          "type": "text",
          "label": {
            "en": "Email address",
            "nl": "E-mailadres",
            "fr": "Adresse e-mail",
            "de": "E-Mail-Adresse"
          },
          "placeholder": "owner-or-installer@email.com",
          "required": true,
          "value": ""
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord",
            "fr": "Mot de passe",
            "de": "Passwort"
          },
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Envoy gateway",
        "nl": "Envoy-gateway",
        "fr": "Passerelle Envoy",
        "de": "Envoy-Gateway"
      },
      "children": [
        {
          "id": "envoy_serial",
          "type": "text",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer",
            "fr": "Numéro de série",
            "de": "Seriennummer"
          },
          "placeholder": "122226012345",
          "required": true,
          "value": ""
        },
        {
          "id": "envoy_ip",
          "type": "text",
          "label": {
            "en": "Local IP address",
            "nl": "Lokaal IP-adres",
            "fr": "Adresse IP locale",
            "de": "Lokale IP-Adresse"
          },
          "placeholder": "10.0.0.123",
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Advanced settings",
        "nl": "Geavanceerde instellingen",
        "fr": "Paramètres avancés",
        "de": "Erweiterte Einstellungen"
      },
      "children": [
        {
          "id": "always_on",
          "type": "checkbox",
          "label": {
            "en": "Always on",
            "nl": "Altijd aan",
            "fr": "Toujours activé",
            "de": "Immer eingeschaltet"
          },
          "hint": {
            "en": "Prevent this device from turning off, even when running 'Turn all devices off' flows.",
            "nl": "Voorkom dat dit apparaat wordt uitgeschakeld, zelfs bij 'Schakel alle apparaten uit'-flows.",
            "fr": "Empêche cet appareil de s'éteindre, même lors de l'exécution de Flows « Éteindre tous les appareils ».",
            "de": "Verhindert, dass dieses Gerät ausgeschaltet wird, auch wenn Flows „Alle Geräte ausschalten“ ausgeführt werden."
          },
          "value": false
        },
        {
          "id": "pel_offset",
          "type": "number",
          "label": {
            "en": "Self-use offset",
            "nl": "Zelfverbruik offset",
            "fr": "Décalage de l'autoconsommation",
            "de": "Versatz für Eigenverbrauch"
          },
          "description": {
            "en": "The export limit value in Watts used when in Self-use only mode (defaults to 0).",
            "nl": "De terugleverlimiet in Watt die wordt gebruikt in de modus Alleen zelfverbruik (standaard 0).",
            "fr": "Valeur limite d'export en watts utilisée en mode Autoconsommation uniquement (0 par défaut).",
            "de": "Der Einspeisegrenzwert in Watt, der im Modus „Nur Eigenverbrauch“ verwendet wird (Standard 0)."
          },
          "required": true,
          "value": 0,
          "min": 0
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Update interval",
            "nl": "Update-interval",
            "fr": "Intervalle de mise à jour",
            "de": "Aktualisierungsintervall"
          },
          "hint": {
            "en": "How often live power is read from the gateway, in seconds (5-120, default 15). Shorter intervals give faster updates but put more load on the Envoy.",
            "nl": "Hoe vaak het actuele vermogen van de gateway wordt uitgelezen, in seconden (5-120, standaard 15). Kortere intervallen geven snellere updates maar belasten de Envoy meer.",
            "fr": "Fréquence de lecture de la puissance en direct sur la passerelle, en secondes (5 à 120, 15 par défaut). Des intervalles plus courts donnent des mises à jour plus rapides, mais sollicitent davantage l'Envoy.",
            "de": "Wie oft die aktuelle Leistung vom Gateway abgerufen wird, in Sekunden (5 bis 120, Standard 15). Kürzere Intervalle liefern schnellere Aktualisierungen, belasten den Envoy aber stärker."
          },
          "value": 15,
          "min": 5,
          "max": 120,
          "units": "s"
        }
      ]
    }
  ]
}
