{
  "name": {
    "en": "Enphase Home",
    "nl": "Enphase Home"
  },
  "images": {
    "small": "/drivers/homeload/assets/images/small.png",
    "large": "/drivers/homeload/assets/images/large.png"
  },
  "class": "sensor",
  "discovery": "enphase-envoy",
  "capabilities": [
    "measure_power",
    "meter_power",
    "meter_power_today",
    "measure_power.consumed",
    "meter_power.consumed",
    "meter_power_today.consumed",
    "last_update"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Grid power",
        "nl": "Netstroom vermogen"
      }
    },
    "meter_power": {
      "title": {
        "en": "Grid energy",
        "nl": "Netstroom energie"
      }
    },
    "meter_power_today": {
      "title": {
        "en": "Grid energy today",
        "nl": "Netstroom energie vandaag"
      }
    },
    "measure_power.consumed": {
      "title": {
        "en": "Home consumption power",
        "nl": "Huisverbruik vermogen"
      }
    },
    "meter_power.consumed": {
      "title": {
        "en": "Home consumption energy",
        "nl": "Huisverbruik energie"
      }
    },
    "meter_power_today.consumed": {
      "title": {
        "en": "Home consumption energy today",
        "nl": "Huisverbruik energie vandaag"
      }
    }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power"
  },
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "user_email",
      "type": "text",
      "label": {
        "en": "Enphase Account Email",
        "nl": "Enphase-account e-mailadres"
      },
      "placeholder": "owner-or-installer@email.com",
      "required": true,
      "value": ""
    },
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Enphase Password",
        "nl": "Enphase-wachtwoord"
      },
      "required": true,
      "value": ""
    },
    {
      "id": "envoy_serial",
      "type": "text",
      "label": {
        "en": "Envoy Serial Number",
        "nl": "Envoy serienummer"
      },
      "placeholder": "122226012345",
      "required": true,
      "value": ""
    },
    {
      "id": "envoy_ip",
      "type": "text",
      "label": {
        "en": "Envoy Local IP Address",
        "nl": "Lokaal IP-adres van de Envoy"
      },
      "placeholder": "10.0.0.123",
      "required": true,
      "value": ""
    }
  ]
}
