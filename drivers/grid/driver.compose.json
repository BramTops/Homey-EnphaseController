  },
  "repair": [
    {
      "id": "repair"
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Enphase account",
        "nl": "Enphase-account",
        "fr": "Compte Enphase",
        "de": "Enphase-Konto"
      },
      "children": [
        {
          "id": "user_email",
          "type": "text",
          "label": {
            "en": "Email address",
            "nl": "E-mailadres",
            "fr": "Adresse e-mail",
            "de": "E-Mail-Adresse"
          },
          "placeholder": "owner-or-installer@email.com",
          "required": true,
          "value": ""
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord",
            "fr": "Mot de passe",
            "de": "Passwort"
          },
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Envoy gateway",
        "nl": "Envoy-gateway",
        "fr": "Passerelle Envoy",
        "de": "Envoy-Gateway"
      },
      "children": [
        {
          "id": "envoy_serial",
          "type": "text",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer",
            "fr": "Numéro de série",
            "de": "Seriennummer"
          },
          "placeholder": "122226012345",
          "required": true,
          "value": ""
        },
        {
          "id": "envoy_ip",
          "type": "text",
          "label": {
            "en": "Local IP address",
            "nl": "Lokaal IP-adres",
            "fr": "Adresse IP locale",
            "de": "Lokale IP-Adresse"
          },
          "placeholder": "10.0.0.123",
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Advanced settings",
        "nl": "Geavanceerde instellingen",
        "fr": "Paramètres avancés",
        "de": "Erweiterte Einstellungen"
      },
      "children": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Update interval",
            "nl": "Update-interval",
            "fr": "Intervalle de mise à jour",
            "de": "Aktualisierungsintervall"
          },
          "hint": {
            "en": "How often live grid and home power is read from the gateway, in seconds (5-120, default 15). Shorter intervals give faster updates but put more load on the Envoy.",
            "nl": "Hoe vaak het actuele net- en huisvermogen van de gateway wordt uitgelezen, in seconden (5-120, standaard 15). Kortere intervallen geven snellere updates maar belasten de Envoy meer.",
            "fr": "Fréquence de lecture de la puissance réseau et domestique sur la passerelle, en secondes (5 à 120, 15 par défaut). Des intervalles plus courts donnent des mises à jour plus rapides, mais sollicitent davantage l'Envoy.",
            "de": "Wie oft Netz- und Hausleistung vom Gateway abgerufen werden, in Sekunden (5 bis 120, Standard 15). Kürzere Intervalle liefern schnellere Aktualisierungen, belasten den Envoy aber stärker."
          },
          "value": 15,
          "min": 5,
          "max": 120,
          "units": "s"
        },
        {
          "id": "phase_capabilities",
          "type": "checkbox",
          "label": {
            "en": "Per-phase values",
            "nl": "Waarden per fase",
            "fr": "Valeurs par phase",
            "de": "Werte pro Phase"
          },
          "hint": {
            "en": "For 3-phase systems with a grid meter: adds grid power and grid voltage for each phase (L1, L2, L3), plus home power per phase when it can be determined (a home consumption meter, or no battery). Has no effect on single-phase systems. Turning this off removes these values and their history.",
            "nl": "Voor 3-fase systemen met een netmeter: voegt netvermogen en netspanning per fase toe (L1, L2, L3), plus huisverbruik per fase als dat te bepalen is (een verbruiksmeter, of geen batterij). Heeft geen effect op 1-fase systemen. Uitschakelen verwijdert deze waarden en hun geschiedenis.",
            "fr": "Pour les systèmes triphasés avec compteur réseau : ajoute la puissance et la tension réseau de chaque phase (L1, L2, L3), ainsi que la consommation domestique par phase lorsqu'elle peut être déterminée (compteur de consommation, ou pas de batterie). Sans effet sur les systèmes monophasés. La désactivation supprime ces valeurs et leur historique.",
            "de": "Für 3-Phasen-Systeme mit Netzzähler: fügt Netzleistung und Netzspannung je Phase hinzu (L1, L2, L3), dazu den Hausverbrauch je Phase, wenn er sich bestimmen lässt (Verbrauchszähler oder keine Batterie). Hat bei 1-Phasen-Systemen keine Wirkung. Beim Ausschalten werden diese Werte und ihr Verlauf entfernt."
          },
          "value": false
        }
      ]
    }
  ]
}
