    "cumulativeImportedCapability": "meter_power",
    "cumulativeExportedCapability": "meter_power.produced"
  },
  "repair": [
    {
      "id": "repair"
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Enphase account",
        "nl": "Enphase-account",
        "fr": "Compte Enphase",
        "de": "Enphase-Konto"
      },
      "children": [
        {
          "id": "user_email",
          "type": "text",
          "label": {
            "en": "Email address",
            "nl": "E-mailadres",
            "fr": "Adresse e-mail",
            "de": "E-Mail-Adresse"
          },
          "placeholder": "owner-or-installer@email.com",
          "required": true,
          "value": ""
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord",
            "fr": "Mot de passe",
            "de": "Passwort"
          },
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Envoy gateway",
        "nl": "Envoy-gateway",
        "fr": "Passerelle Envoy",
        "de": "Envoy-Gateway"
      },
      "children": [
        {
          "id": "envoy_serial",
          "type": "text",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer",
            "fr": "Numéro de série",
            "de": "Seriennummer"
          },
          "placeholder": "122226012345",
          "required": true,
          "value": ""
        },
        {
          "id": "envoy_ip",
          "type": "text",
          "label": {
            "en": "Local IP address",
            "nl": "Lokaal IP-adres",
            "fr": "Adresse IP locale",
            "de": "Lokale IP-Adresse"
          },
          "placeholder": "10.0.0.123",
          "required": true,
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Advanced settings",
        "nl": "Geavanceerde instellingen",
        "fr": "Paramètres avancés",
        "de": "Erweiterte Einstellungen"
      },
      "children": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Update interval",
            "nl": "Update-interval",
            "fr": "Intervalle de mise à jour",
            "de": "Aktualisierungsintervall"
          },
          "hint": {
            "en": "How often live grid and home power is read from the gateway, in seconds (5-120, default 15). Shorter intervals give faster updates but put more load on the Envoy.",
            "nl": "Hoe vaak het actuele net- en huisvermogen van de gateway wordt uitgelezen, in seconden (5-120, standaard 15). Kortere intervallen geven snellere updates maar belasten de Envoy meer.",
            "fr": "Fréquence de lecture de la puissance réseau et domestique sur la passerelle, en secondes (5 à 120, 15 par défaut). Des intervalles plus courts donnent des mises à jour plus rapides, mais sollicitent davantage l'Envoy.",
            "de": "Wie oft Netz- und Hausleistung vom Gateway abgerufen werden, in Sekunden (5 bis 120, Standard 15). Kürzere Intervalle liefern schnellere Aktualisierungen, belasten den Envoy aber stärker."
          },
          "value": 15,
          "min": 5,
          "max": 120,
          "units": "s"
        }
      ]
    }
  ]
}
